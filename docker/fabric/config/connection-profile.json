        "ca.org1.dms.gov.in"
      ]
    }
  },
  "orderers": {
    "orderer.dms.gov.in": {
      "url": "grpc://localhost:7050"
    }
  },
  "peers": {
    "peer0.org1.dms.gov.in": {
      "url": "grpc://localhost:7051"
    }
  },
  "certificateAuthorities": {
    "ca.org1.dms.gov.in": {
      "url": "http://localhost:7054",
      "caName": "ca-org1"
    }
  }
