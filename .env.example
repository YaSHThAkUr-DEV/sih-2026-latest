# ==============================================================================
# SECURE LEGAL & INVESTIGATION DMS - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env (or .env.local) and customize values for your environment.
# ⚠️ DO NOT commit sensitive passwords or production JWT secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION RUNTIME & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 2. POSTGRESQL 18 CORE DATABASE PIPELINE
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dms_db

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION & ENVELOPE ENCRYPTION KEY (KEK)
# ------------------------------------------------------------------------------
# Generate a secure 32+ character random string in production
JWT_SECRET=your_jwt_secret_here_min_32_characters_long

# ------------------------------------------------------------------------------
# 4. MINIO / AWS S3 OBJECT STORAGE SERVICE
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dms-documents
MINIO_REGION=us-east-1

# ------------------------------------------------------------------------------
# 5. REDIS IN-MEMORY CACHE, RATE LIMITING & QUEUE
# ------------------------------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------------------------------------------------------
# 6. HASHICORP VAULT TRANSIT KMS (KEY MANAGEMENT SERVICE)
# ------------------------------------------------------------------------------
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=dms-vault-dev-token

# ------------------------------------------------------------------------------
# 7. BLOCKCHAIN AUDIT TRAIL / HYPERLEDGER FABRIC INTEGRATION
# ------------------------------------------------------------------------------
# Modes: 'simulated' (zero external dependency hash-chain) or 'fabric' (Hyperledger network)
BLOCKCHAIN_MODE=simulated
BLOCKCHAIN_NETWORK_NAME=dms-records-network
BLOCKCHAIN_CHANNEL_NAME=recordschannel
BLOCKCHAIN_CHAINCODE_NAME=dms_audit_cc
